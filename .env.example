# ========= Backend =========
PORT=8080
JWT_SECRET=your_super_secret_change_me

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gmc
# Common production values: require / verify-full
DB_SSLMODE=disable

# Safety: run AutoMigrate only when you explicitly want it
MIGRATE_ON_STARTUP=true

# CORS
# Comma-separated list of allowed origins.
# Example (separate domain): http://localhost:5173,http://my-frontend.com
CORS_ORIGINS=

# WebSocket origin allowlist (same format as CORS_ORIGINS)
WEBSOCKET_ALLOWED_ORIGINS=

# ========= Frontend =========
# Used at Vite build-time inside the frontend Docker image
VITE_API_BASE_URL=/api

